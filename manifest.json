{
  "manifest_version": 3,
  "name": "Где дешевле — Ozon, WB, Яндекс Маркет",
  "version": "1.1.0",
  "description": "Открыли товар на одном маркетплейсе — сразу видно, сколько он стоит на двух других. Ничего настраивать не нужно.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://search.wb.ru/*",
    "https://market.yandex.ru/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ozon.ru/product/*",
        "https://www.wildberries.ru/catalog/*",
        "https://market.yandex.ru/card/*",
        "https://market.yandex.ru/product/*",
        "https://market.yandex.ru/product--*"
      ],
      "js": [
        "src/config.js",
        "src/query.js",
        "src/detect.js",
        "src/logos.js",
        "src/panel.js",
        "src/content.js"
      ],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Где дешевле",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
